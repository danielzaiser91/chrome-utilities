{
  "manifest_version": 3,
  "name": "Web Utility Plugin",
  "description": "This extension will fix some anoying things about multiple websites",
  "version": "1.15.0.1",
  "version_name": "1.15.0.1",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["voe-ask.html"], "matches": ["*://*.aniworld.to/*"] }
  ],
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.1movies.life/*",
        "*://*.amazon.com/*",
        "*://*.amazon.de/*",
        "*://*.animationdigitalnetwork.com/*",
        "*://*.aniworld.to/*",
        "*://*.aternos.org/*",
        "*://*.chess.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.defenestration.co/pg/surveying*",
        "*://*.disneyplus.com/*",
        "*://*.fandom.com/*",
        "*://*.fextralife.com/*",
        "*://www.google.com/maps/*",
        "*://*.keyforsteam.com/*",
        "*://*.keyforsteam.de/*",
        "*://*.lookmovie2.to/*",
        "*://*.luluvdo.com/*",
        "*://*.netflix.com/*",
        "*://*.new-fmovies.cam/*",
        "*://*.playerwatchlm24.xyz/*",
        "*://*.pogchamps.gg/*",
        "*://*.primevideo.com/*",
        "*://*.toggo.de/*",
        "*://*.twitch.tv/*",
        "*://*.vidmoly.biz/*",
        "*://*.vidmoly.me/*",
        "*://*.wowtv.com/*",
        "*://*.wowtv.de/*",
        "*://*.youtube.com/*",
        "*://store.steampowered.com/app/*",
        "*://www.geoguessr.com/*",
        "*://zkjellberg.github.io/dark-souls-3-cheat-sheet*",
        "https://zpjid.com/bkg/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "utility.js",
        "skip.js"
      ]
    },
    {
      "matches": ["*://voe.sx/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["voe-redirect.js"]
    },
    {
      "matches": ["*://*.toggo.de/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["toggo-main-world.js"]
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["youtube-main-world.js"]
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["netflix-main-world.js"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
