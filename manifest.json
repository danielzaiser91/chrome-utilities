{
  "manifest_version": 3,
  "name": "Web Utility Plugin",
  "description": "This extension will fix some anoying things about multiple websites",
  "version": "1.7.4.0",
  "version_name": "1.7.4.0",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.1movies.life/*",
        "*://*.amazon.com/*",
        "*://*.amazon.de/*",
        "*://*.animationdigitalnetwork.com/*",
        "*://*.aniworld.to/*",
        "*://*.aternos.org/*",
        "*://*.chess.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.defenestration.co/pg/surveying*",
        "*://*.disneyplus.com/*",
        "*://*.fandom.com/*",
        "*://*.fextralife.com/*",
        "*://www.google.com/maps/*",
        "*://*.instagram.com/*",
        "*://*.keyforsteam.com/*",
        "*://*.keyforsteam.de/*",
        "*://*.lookmovie2.to/*",
        "*://*.luluvdo.com/*",
        "*://*.netflix.com/*",
        "*://*.new-fmovies.cam/*",
        "*://*.playerwatchlm24.xyz/*",
        "*://*.pogchamps.gg/*",
        "*://*.primevideo.com/*",
        "*://*.twitch.tv/*",
        "*://*.wowtv.com/*",
        "*://*.wowtv.de/*",
        "*://*.youtube.com/*",
        "*://store.steampowered.com/app/*",
        "*://www.geoguessr.com/*",
        "*://zkjellberg.github.io/dark-souls-3-cheat-sheet*",
        "https://zpjid.com/bkg/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "utility.js"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
